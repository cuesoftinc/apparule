# Native-run config for web (compose users: use the root .env instead).
# NEXT_PUBLIC_* are inlined at build time.

# TEST_MODE (web standard): true = Google button goes straight to /dashboard
# (no Google redirect) and the API client targets the in-app mock server.
NEXT_PUBLIC_TEST_MODE=

# ── Real backend (TEST_MODE unset) ──
# Sign-in is Google SSO served by the API (see api/common/.env.example); the
# web app needs no Google settings. GOOGLE_REDIRECT_URI there must be this
# origin's /api/v1/auth/sso/google/callback.

# Server-side: where /api/v1 is proxied (read at request time).
API_URL=http://localhost:8080
UPLOADS_URL=http://localhost:8082
