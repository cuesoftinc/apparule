# Native (non-compose) run: cp .env.example .env. Names follow
# docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8083
LOG_LEVEL=INFO

# ── Kafka (compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# api/common's URL, woken after each outcome (cloud only; empty = no wake-up)
WAKE_COMMON_URL=

# ── Object storage: gcs (cloud, ADC) | s3 (SeaweedFS in compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=apparule-local
STORAGE_PREFIX=apparule/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── Paystack (empty = notify-only, the self-host mode without payments) ──
PAYSTACK_SECRET_KEY=
PLATFORM_FEE_BPS=1000

# ── Delivery: FCM push (ADC) and Brevo money emails; empty = off ──
FCM_PROJECT_ID=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Apparule

# The JSON Schemas; the image copies them to /app/contract.
CONTRACT_DIR=../common/contract
