# Native (non-compose) run: cp .env.example .env. Names follow
# docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8080
CORS_ORIGINS=http://localhost:3000

# ── Postgres (common is its only client; a non-superuser role so RLS applies) ──
DATABASE_URL=postgres://apparule_app:apparule@localhost:5432/apparule?sslmode=disable

# ── Google sign-in (X-1): the API runs the OAuth flow and signs its own
#    session JWT. GOOGLE_REDIRECT_URI must be registered with the Google client. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/sso/google/callback
# Origin of the web app: redirect target after sign-in and the cookie CSRF check.
WEB_URL=http://localhost:3000
JWT_SECRET=
SESSION_SECRET=
JWT_ACCESS_TTL=24h
# Legacy token lifetime in hours; JWT_ACCESS_TTL wins when both are set.
JWT_EXPIRY_HOURS=
SESSION_COOKIE_NAME=apparule_session
OAUTH_STATE_COOKIE=apparule_oauth_state
# Sign-in start limits per source and overall; hops of X-Forwarded-For to trust.
SSO_START_SOURCE_RATE_LIMIT=10
SSO_START_GLOBAL_RATE_LIMIT=300
SSO_STATE_SOURCE_LIMIT=20
SSO_STATE_GLOBAL_LIMIT=2000
TRUSTED_PROXY_HOPS=0

# ── Upload tickets (S-15): kid:<base64url Ed25519 seed>. go run ./cmd/ticketkey ──
UPLOAD_TICKET_PRIVATE_KEY=
UPLOADS_URL=http://localhost:8082/api/v1/uploads

# ── Kafka (compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# ── Redis: rate limits + the daily upload quota (unset = limits off) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_KEY_PREFIX=apparule

# ── Object storage: gcs (cloud, ADC) | s3 (SeaweedFS in compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=apparule-local
STORAGE_PREFIX=apparule/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── Paystack: webhook signatures (secret) and client checkout (public) ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Cloud Scheduler OIDC for POST /internal/jobs/{name} (unset = 503) ──
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=

# ── Scale to zero (cloud only; empty = always running) ──
WAKE_COMMON_URL=
WAKE_SEGMENTATION_URL=
WAKE_COMMERCE_URL=
