{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparule.cuesoft.io/contract/notifications.created.schema.json",
  "title": "apparule.notifications.created",
  "description": "common (outbox) -> commerce, on cuelabs.requests. common wrote a NOTIFICATION row (the source of truth, data-model.md §6.4); commerce delivers it: FCM push for the kinds in order-lifecycle.md §4, a silent push for capture results, Brevo email for money events only, social kinds coalesced. Delivery is best-effort. Key: account id.",
  "type": "object",
  "required": ["notification_id", "account_id", "kind", "created_at", "recipient"],
  "additionalProperties": false,
  "properties": {
    "notification_id": { "$ref": "defs.schema.json#/$defs/id" },
    "account_id": { "$ref": "defs.schema.json#/$defs/id" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "ref": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["request", "post", "session", "account"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "text": { "type": "string", "description": "The activity-sheet line, already rendered by common." },
    "recipient": {
      "type": "object",
      "required": ["push_tokens"],
      "additionalProperties": false,
      "properties": {
        "push_tokens": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "email": { "type": "string", "format": "email" },
        "display_name": { "type": "string" }
      }
    },
    "money": { "$ref": "defs.schema.json#/$defs/money" }
  }
}
