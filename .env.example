# Apparule local development (docker compose). Copy to .env: cp .env.example .env
# Variable names follow docs/system-design.md §10.3. Compose provides
# Postgres, Kafka, Redis and SeaweedFS (S3); the defaults in docker-compose.yml point at them, so most lines here stay
# commented.

# ── Upload tickets (S-15): api/common signs, api/uploads verifies ──
# LOCAL DEVELOPMENT ONLY. Never reuse this pair anywhere else; generate real
# keys with: cd api/common && go run ./cmd/ticketkey <kid>
UPLOAD_TICKET_PRIVATE_KEY=local-dev:KvhMCeXZvI6FsjZv2PdcHZh-bZoHLRPfObZil_cj1p0
UPLOAD_TICKET_PUBLIC_KEYS=local-dev:HS1eCip4xPivZrSobn7CfpsSBFkQRCDkoMh2uSEB0wE

# ── Browser origins allowed by common and uploads ──
CORS_ORIGINS=http://localhost:3000

# ── Google sign-in (X-1). Create an OAuth web client in Google Cloud and add
# GOOGLE_REDIRECT_URI as an authorized redirect URI. The browser reaches the
# API through the web origin, so the redirect is the web's /api/v1 path and
# WEB_URL is the web origin. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/google/callback
WEB_URL=http://localhost:3000
# Exact mobile return URLs sign-in may hand back to (default apparule://app).
# APP_RETURN_URLS=apparule://app
# Generate each with: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=
# JWT_ACCESS_TTL=24h
# JWT_EXPIRY_HOURS=
# SESSION_COOKIE_NAME=apparule_session
# OAUTH_STATE_COOKIE=apparule_oauth_state

# ── FCM push (commerce) uses ADC with this project id ──
GOOGLE_CLOUD_PROJECT=

# ── Paystack (test keys). Empty: checkout is unavailable and commerce runs
# notify-only (self-host without payments, §10.2). ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Delivery (optional): Brevo emails ──
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ── Overrides for managed services (leave unset for compose) ──
# KAFKA_BROKERS=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SSL_CA=
# DATABASE_URL=
# REDIS_HOST=
# REDIS_PORT=6379
# STORAGE_DRIVER=gcs
# STORAGE_BUCKET=
# STORAGE_PREFIX=apparule/stg
# S3 driver (STORAGE_DRIVER=s3): endpoint, keys and TLS (TLS is on unless set to false).
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_USE_SSL=true
# Public URL clients POST photos to (default /api/v1/uploads).
# UPLOADS_URL=/api/v1/uploads
# Base URLs of services to wake after publishing (scale-to-zero hosts).
# WAKE_COMMON_URL=
# WAKE_SEGMENTATION_URL=
# WAKE_COMMERCE_URL=

# ── web (Next.js). NEXT_PUBLIC_* are inlined at build time. ──
