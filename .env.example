# Apparule local development (docker compose). Copy to .env: cp .env.example .env
# Variable names follow docs/system-design.md §10.3. Compose provides
# Postgres, Kafka, Redis, SeaweedFS (S3) and the Firebase auth emulator; the
# defaults in docker-compose.yml point at them, so most lines here stay
# commented.

# ── Upload tickets (S-15): api/common signs, api/uploads verifies ──
# LOCAL DEVELOPMENT ONLY. Never reuse this pair anywhere else; generate real
# keys with: cd api/common && go run ./cmd/ticketkey <kid>
UPLOAD_TICKET_PRIVATE_KEY=local-dev:KvhMCeXZvI6FsjZv2PdcHZh-bZoHLRPfObZil_cj1p0
UPLOAD_TICKET_PUBLIC_KEYS=local-dev:HS1eCip4xPivZrSobn7CfpsSBFkQRCDkoMh2uSEB0wE

# ── Browser origins allowed by common and uploads ──
CORS_ORIGINS=http://localhost:3000

# ── Firebase (X-1). The emulator is used while FIREBASE_AUTH_EMULATOR_HOST
# is set (compose default); set it empty and use a real project id to verify
# real Google sign-in tokens. ──
GOOGLE_CLOUD_PROJECT=demo-apparule
# FIREBASE_AUTH_EMULATOR_HOST=

# ── Paystack (test keys). Empty: checkout is unavailable and commerce runs
# notify-only (self-host without payments, §10.2). ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Delivery (optional): FCM push uses GOOGLE_CLOUD_PROJECT with ADC; Brevo emails ──
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ── Overrides for managed services (leave unset for compose) ──
# KAFKA_BROKERS=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SSL_CA=
# REDIS_HOST=
# STORAGE_DRIVER=gcs
# STORAGE_BUCKET=
# STORAGE_PREFIX=apparule/stg

# ── web (Next.js). NEXT_PUBLIC_* are inlined at build time. ──
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
